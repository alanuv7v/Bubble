{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "bubble",
  "applicationIcon": "icon.png",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/dist",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "enableExtensions": true,
  "dataLocation": "system",
  "tokenSecurity": "one-time",
  "nativeAllowList": ["app.*", "window.*", "os.*", "filesystem.*", "extensions.*"],
  "extensions": [{
    "id": "sqlite3",
    "commandWindows": "\"${NL_PATH}/bin/sqlite3/neutralinojs-ext-sqlite3.exe\" --run",
    "commandLinux": "\"${NL_PATH}/bin/sqlite3/neutralinojs-ext-sqlite3\" --run",
    "commandDarwin": "\"${NL_PATH}/bin/sqlite3/neutralinojs-ext-sqlite3\" --run"
  }],
  "modes": {
    "window": {
      "icon": "icon.png",
      "title": "Bubble",
      "minWidth": 800,
      "minHeight": 800,
      "center": true,
      "resizable": true,
      "injectGlobals": true,
      "exitProcessOnClose": true,

      "fullScreen": false,
      "borderless": true,
      "maximize": false,
      "useSavedState": false,
      "width": 800,
      "height": 800,
      "enableInspector": true,
      "openInspectorOnStartup": false
    }
  },
  "cli": {
    "binaryName": "bubble",
    "resourcesPath": "/dist",
    "extensionsPath": "/bin/sqlite3",
    "distributionPath": "/release",
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0",
    "builder": {
      "windows": {
        "targets": {
          "target": "nsis",
          "icon": "icon.png",
          "sidebarImage": "icon.png",
          "headerImage": "icon.png"
        }
      }
    }
  }
}
