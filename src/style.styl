:root {
  background: var(--bg-color);

  overflow: hidden;
  color: var(--ui-color);
  box-sizing: border-box;
  caret-color: var(--light);
  text-wrap: auto;
  font-size: 16px;

  /* Shared rhythm for gaps, padding, and offsets. */
  --space-xs: 0.25lh;
  --space-sm: 0.5lh;
  --space-md: 1lh;
}

/* ========================================================================== */
/* Global defaults and app shell */
/* ========================================================================== */

* {
  line-height: 1lh
  transition: box-shadow 0.125s, outline-color 0.2s;
  animation: fadein 0.2s ease-in;
}


*:focus {
  outline: 2px solid var(--border-color)
  outline-offset: -1px;
  background-color: var(--active-bg-color);
}

b,
strong {
  font-weight: 700;
}

title {
  display: none;
}
* {
  box-sizing: border-box;
}
body {
  width: 100dvw;
  height: 100svh;
  padding: 0px;
  margin: 0px;
}
main {
  width: 100dvw;
  height: 100svh;
  display: flex;
  position: relative;

  > stack-c {
    display: flex;
    flex-direction: column;
    box-shadow: inset -1px 0px 0px 0px var(--mild-border-color);
    > * {
      width: 100%;
      border-radius: 0;
    }
  }
  > article {
    width: 100%
    flex-grow: 1;
    overflow: hidden;
    position: relative
    display: flex
    align-items: center
    justify-content: center
    > * {
      max-height: 100%;
      overflow: auto
    }
  }
}
p {
  margin: 0px;
}

.resize {
  resize: both;
}

nav {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  align-items: stretch;
  width: 12ch;
  word-break: keep-all;
  overflow-x: auto;

  button {
    width: 100%;
  }
}

/* ========================================================================== */
/* Form controls */
/* ========================================================================== */

*[contenteditable="true"] {
  min-height: 2lh;
  padding: var(--space-sm);
  overflow: auto;
  border-radius: var(--border-rad);
}
/* *[contenteditable="true"]:hover {
  box-shadow: inset 0px 0px 0px 1px var(--mild-border-color);
}
*[contenteditable="true"]:focus {
  box-shadow: inset 0px 0px 0px 1px var(--border-color);
}
*/


img {
  isolation: isolate;
}

input, button, select, *[contenteditable="true"] {

  position: relative;
  
  padding-left: var(--space-sm);
  padding-right: var(--space-sm);
  // padding-top: 0.5lh;
  // padding-bottom: 0.5lh;

  overflow: auto;
  
  outline: solid 1px var(--mild-border-color)
  outline-offset: 0px

  background-color: var(--bg-color);
  border-radius: var(--border-rad);
  
  width: fit-content;
  height: fit-content;
  min-height: 2lh;
  
  box-sizing: border-box;
  font-family: inherit;
  font-weight: inherit;
  font-size: inherit;
  border: none;

  color: var(--ui-color);
  white-space: nowrap;
}

button:hover, .key:hover, select:hover, *[contenteditable="true"]:hover, input:hover {
  z-index: 2;
  outline-color: var(--border-color)
  outline-width: 2px
  outline-offset: -1px
}

select::after {
  position: absolute;
  right: 1ch;
  height: 1lh;
  top: calc(50% - var(--space-sm));
  content: "⇵";
  display: flex
  align-items: center
}

*[contenteditable="true"] {
  display: inline-block
  cursor: text
  min-width: 5ch
  white-space: break-spaces
}
button {
  white-space: nowrap;
  overflow: hidden;
  cursor pointer
}

select {
  font-family: inherit;
  font-size: inherit;
}

#chat-listeners {
  position: relative;
}

.multiselect {
  max-height: 15lh;
  overflow: auto;
  background: var(--bg-color)
  border-radius: var(--border-rad)
  padding: var(--space-sm)
}

.multiselect[hidden] {
  display: none;
}

.multiselect > header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm)
}

.multiselect .close {
  padding: var(--space-sm)
}

.multiselect .options > label {
  display: flex;
  align-items: center;
  gap: 0.5ch
  white-space: nowrap;
}

/* ========================================================================== */
/* Shared controls, groups, and motion */
/* ========================================================================== */

utils-c {
  display: flex;
  gap: var(--space-xs);
}

message-c {
  utils-c group-c > span {
    padding: var(--space-sm)
  }
}


button:has(> img), .select:has(> img) {
  display: flex;
  gap: var(--space-xs);
  align-items: center;
}

button > img, .select > img /* icon */ {
  aspect-ratio: 1/1;
  height: 0.5 lh;
}

@keyframes pop {
  from {
    scale: 1;
  }
  50% {
    scale: 1.1;
  }
  to { 
    scale: 1;
  }
}

@keyframes fadein {
  from {
    opacity: 0%;
  }
  to { 
    opacity: 100%;
  }
}

@keyframes rise {
  from {
    opacity: 70%;
    translate: 0px var(--space-xs);
    scale: 0.9;
  }
  to { 
    opacity: 100%;
    translate: 0px 0px;
    scale: 1;
  }
}

group-c {
  border-radius: var(--border-rad);
  > * {
    flex-grow: 1;
  }
}
group-c.horizontal {
  
  position: relative;
  display: flex;
  align-items: center
  > *:not(button) {
    align-content: center;
    padding: 0.33lh;
  }
  > * {
    border-radius: 0px;
  }
  > *:first-child {
    border-top-left-radius: var(--border-rad);
    border-bottom-left-radius: var(--border-rad);
  }
  > *:last-child {
    border-top-right-radius: var(--border-rad);
    border-bottom-right-radius: var(--border-rad);
  }
}


group-c.vertical {
  
  position: relative;
  display: flex;
  flex-direction: column;
  animation: fadein 0.3s ease-in;


  > * {
    border-radius: 0px;
    box-shadow: inset 0px 0px 0px 1px var(--mild-border-color);
    margin-top: -1px;
    width: 100%;
  }
  > *:not(button) {
    align-content: center;
    padding: 0.33lh;
    text-align: center;
  }
  > *:last-child {
    border-bottom-left-radius: var(--border-rad);
    border-bottom-right-radius: var(--border-rad);
  }
  > *:first-child {
    border-top-left-radius: var(--border-rad);
    border-top-right-radius: var(--border-rad);
  }
}

not-connected {
  padding: var(--space-md);
  > * {
    white-space: break-spaces;
  }
}

/* ========================================================================== */
/* Responsive layout */
/* ========================================================================== */

@media (max-width: 800px) {
  request-c {
    footer {
      flex-wrap: nowrap;
      overflow: auto;
    }
  }
  body {
    min-height: 0;
    flex-direction: column;
    nav {
      width: 100%;
      flex-grow: 1;
      flex-shrink: 0;
      flex-direction: row;
      * {
        width: fit-content;
        flex-direction: row;
      }
    }
  }
  body > main {
    flex-direction: column;
    > stack-c {
      flex-direction: row;  
      box-shadow: inset 0px -1px 0px 0px var(--mild-border-color);
      overflow: auto
      max-width: 100vw
      > * {
        margin-left: -1px;
        min-width: fit-content;
        box-shadow: inset 1px 0px 0px 0px var(--mild-border-color),inset -1px 0px 0px 0px var(--mild-border-color),inset 0px -1px 0px 0px var(--mild-border-color);
      }
    }  
  }
}



/* ========================================================================== */
/* Inputs and typography */
/* ========================================================================== */

input {
  //all: inherit;
  color: inherit;
  font-size: inherit
  font-family: inherit
  border: none;
}

input[type="number"] {
  min-width 10ch
}

input[type="checkbox"] {
  appearance: none;
  padding: 0px;
  width: 1.5lh
  height: 1.5lh;
  min-height: 1.5lh;
  display: inline-grid;
  place-content: center;
  box-shadow: inset 0px 0px 0px 1px var(--mild-border-color);
}

input[type="checkbox"]::before {
  content: "";
  width: 1.75ch;
  aspect-ratio: 1/1;
  clip-path: polygon(14% 44%, 0 65%, 50% 100%, 100% 16%, 80% 0%, 43% 62%);
  opacity: 0;
  transition: opacity 0.05s linear;
  background-color: var(--light);
}

input[type="checkbox"]:checked::before {
  opacity: 1;
}


input[type="checkbox"]:disabled {
  background: var(--shade);
  cursor: not-allowed;
}


.pretty {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

h1, h2, h3, h4, h5 {
  margin: unset;
  display: inline-block;
  width: fit-content;
  height: fit-content;
  white-space: pre;
}

h1 {
  font-size: 3rem
  line-height: 3lh
}

h2 {
  font-size: 1.5rem
  line-height: 1.5lh
}

h3 {
  font-size: 1.25rem
  line-height: 1.25lh
}

/* ========================================================================== */
/* Utility states and small content elements */
/* ========================================================================== */

start-c {
  width: 100%;
  height: 100%;
  h1 {
    opacity: 50%;
  }
  wrap-c {
    gap: var(--space-md);
  }
  group-c {
    width: 20ch;
    button {
      white-space: pre-line;
    }
  }
}


*[tooltip] {
  position: relative;
  overflow: visible;
}

*[tooltip]:hover::after {
  content: attr(tooltip);
  position: absolute;
  bottom: 0px;
  left: 0px;
  padding: var(--space-xs);
  transform: translate(-0%, 100%);
  background-color: var(--bg-color);
  pointer-events: none;
  width: fit-content;
  height: fit-content;
  z-index: 3;
}

*[disabled] {
  opacity: 50%;
}


ul {
  margin: 0px;
  padding-left: 3ch;
}
*{
  scrollbar-color: var(--mild-border-color) rgba(0,0,0,0);
  scrollbar-width: thin;
}

group-c > *  {
  scale: 1 !important;  
}



/* ========================================================================== */
/* Chat, lists, and message layout */
/* ========================================================================== */

in-chat {
  overflow: hidden;
  display: flex;
  flex-direction: column;
  flex-grow: 1;

  height: 100%
  width: 100%

  > * {
    max-width: 100%
  }
  img.profile {
    width: 12ch
    height: 12ch
  }
  img.profile:hover, img.profile:focus {
    width: 24ch
    height: 24ch
  }
}
chats-c {
  display: flex
  flex-direction: column
  
  gap: var(--space-sm);
  align-items: center;

  list-c > .item > .content {
    flex-direction: column
    flex-wrap: wrap
    > .info {
      flex-grow: 1
      display: flex
      flex-direction: column
      min-width: 30ch
      gap: var(--space-xs)
    }
  }
}

list-c {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  align-items: stretch
  justify-content: flex-start;
  
  flex-grow: 1
  flex-shrink: 1
  flex-basis: auto
  min-height: 0
  overflow: auto

  > .item {
    padding: var(--space-md);
    border-radius: var(--border-rad);
    transition: background 0.2s ease;
    display: flex
    flex-direction: row
    cursor: pointer;
  }
  .content {
    display: flex
    flex-wrap: wrap
    align-items: baseline
    > *:first-child {
      flex-grow: 1
    } 
    group-c {
      width: fit-content
      height: fit-content
    }
  }
}

list-c > .item > .content {
  display: flex
  gap: var(--space-sm);
  flex: 1;
}

list-c > .item:hover {
  background-color: var(--active-bg-color);
}

list-c > .item > .delete {
  flex-shrink: 0;
}

.error {
  color: var(--error);
}

chats-c list-c > .item .profiles {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  overflow: auto
  align-self: flex-end
  position: relative
}

chats-c list-c > .item img.profile {
  width: 8lh;
  height: 8lh;
  border-radius: var(--border-rad);
}

input[placeholder="ID"] {
  min-width: 20ch;
}

request-c {
  padding: var(--space-sm);
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  outline: 2px solid var(--mild-border-color);
  wrap-c {
    flex-wrap: nowrap;
    overflow: visible;
    align-items: center;
    justify-content: space-between;
    prompt-c {
      width: 100% !important
      max-width: unset !important
      overflow-wrap: anywhere;
      flex-grow: 1;
      flex-shrink: 1;
      max-height: 50vh;
    }
    prompt-c.blank br {
      display: none;
    }
    prompt-c.blank::after {
      content: "Write me a Haiku.";
      color: var(--border-color);
    }
  }
  footer {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    > * {
      line-height: 1lh
    }
  }
}

wrap-c {
  display: flex;
}

interactions-c {
  position: relative;
  flex-grow: 1;

  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: auto;
}

message-c:not(:last-child) {
  box-shadow: inset 0px -1px 0px 0px var(--mild-border-color);
}
message-c:hover {
  box-shadow: inset 0px 0px 0px 4px var(--mild-border-color);
  
  utils-c {
    opacity: 100%;
  }
}


message-c {
  
  /* background-color: var(--bg-color); */
  /* backdrop-filter: blur(5px); */

  display: block;

  width: 100%;
  max-width: 1200px;
  padding: var(--space-md);

  gap: var(--space-sm);

  > img.profile {
    margin-right: var(--space-md)
    margin-bottom: var(--space-md)
    float: left
  }
  > h3.name {
    display: block
    padding-bottom: var(--space-sm)
  }

  > utils-c {
    width: 100%;
    margin-top: var(--space-sm);
    justify-content: flex-end;
    align-items: baseline;
    opacity: 0%;
    transition: opacity 0.2s
    gap: var(--space-sm);
    flex-wrap: wrap;
    * {
     height: 2lh;
    }
  }

  > wrap-c {
    flex-wrap: nowrap;
    gap: var(--space-md);
  }
  article {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    flex-grow: 1;
    wrap-c {
      align-items: baseline;
    }
  }
  name-c {
    font-weight: 600;
    flex-grow: 1;
  }

  content-c {
    line-height: 1.25lh;
  }
}

/* ========================================================================== */
/* Rich text and object editor */
/* ========================================================================== */

@css {
  span.quote {
    color: var(--quote);
  }
  span.quote.single { font-style: italic; }
  span.quote.double { color: var(--quote); }
  span.quote.curly { font-weight: bold; }
  span.quote.backtick {
    font-family: monospace;
  }
}

.pending::after { 
  margin-left: 0.5ch;
  content: ".";
  white-space: pre;
  animation: pending 0.75s linear 0s infinite;
}

@keyframes pending {
  0% {
    content: "."
  }
  16.6% {
    content: ".."
  }
  33.3% {
    content: " ..."
  }
  49.9% {
    content: "  ..."
  }
  66.6% {
    content: "   .."
  }  
  100% {
    content: "    ."
  }
}


obj-c {
  display: flex
  flex-direction: column
  gap: var(--space-xs)
  width: fit-content
  
  padding: var(--space-sm)
  border-radius: var(--border-rad)

  > pair-c {
    display: flex
    flex-wrap: wrap
    align-items: flex-start
    gap: 1ch
    > key-c {
      padding-top: var(--space-sm)
      padding-bottom: var(--space-sm)
    }
    > key-c::after {
      content: ":"
    }
  }
}
arr-c {
  display: flex
  flex-wrap: wrap
  gap: 0.5ch
  > group-c {
    display: flex
  }
}
arr-c:has(> group-c > obj-c) {
  flex-direction: column
}

pair-c:has(> obj-c) {
  flex-direction: column
  > key-c {
    font-weight: bold
  }
  > obj-c {
    padding-left: var(--space-sm)
    box-shadow: inset 2px 0px 0px 0px var(--ui-color)
  }
}

*.error {
  --mild-border-color: var(--error)
  --border-color: var(--error)
  color: var(--error)
}

val-c {
  display: block
  min-height: 2lh
  //padding: 0.5lh
}

obj-editor label:has(> input[type="checkbox"]) {
  display: inline-flex
  align-items: center
  gap: 0.35em
  margin-right: 0.5em
  font-size: 0.85em
}

obj-editor .control.disabled {
  opacity: 0.45
  pointer-events: none
}

obj-editor .notice:not(:empty) {
  color: var(--error)
  font-size: 0.85em
}

obj-editor {
  display: flex
  flex-direction: column
  gap: var(--space-sm)
  max-width: 100%
  align-items: flex-end
}


/* ========================================================================== */
/* Bubby cards and edit views */
/* ========================================================================== */

input[type="datetime-local"]{
  color: var(--weird) !important
}

input[type="datetime-local"]::after {
  content: "NEVER"
  display: block
  width: 100px
  height: 100px
}

bubbies-c {
  display: flex
  flex-direction: column
  align-items: center
}
bubbies-c > list-c {
  display: flex
  flex-direction: row
  flex-wrap: wrap
  align-items: center
  justify-content: center
  gap: var(--space-sm)
  > div {
    > img {
      width: 100%
      aspect-ratio: 1/1
    }
    > div {
      padding: var(--space-md)
      text-overflow: ellipsis
      overflow: clip
      text-align: center
    }
    background: var(--bg-color)
    height: fit-content
    cursor: pointer
    display: flex
    flex-direction: column
    width: 18ch
    outline: 1px solid var(--mild-border-color)
    border-radius: var(--border-rad)
    
  }
  > div:hover {
    outline: 4px solid var(--border-color)
  } 
}


edit-chat, edit-bubby, llm-config, user-config {
  display: flex
  flex-direction: column
  align-items: center

  padding: var(--space-sm)
  gap: var(--space-sm)

  overflow: auto
}


edit-chat {
  width: fit-content
  > * {
    width: 100%
  }
}

edit-bubby {

  > div {
    display: flex
    flex-direction: column
    align-items: center
    gap: var(--space-sm)
    img.profile {
      width: 20ch
    }
  }
}

img.profile {
  flex-shrink: 0;
  object-fit: cover;
  border-radius: var(--border-rad);
  background-color: var(--mild-border-color);
  transition: width 0.2s, height 0.2s;
}


/* ========================================================================== */
/* Shared page containers and final view rules */
/* ========================================================================== */

chats-c, bubbies-c, llm-configs {
  display: flex
  flex-direction: column
  overflow: auto
  gap: var(--space-sm)
  width: 100%
  height: 100%
  padding: var(--space-sm)
  align-items: center
  > list-c {
    width: 100%
    flex-grow: 1
  }
  > group-c {
    width: fit-content
  }
}

edit-chat {
  overflow: auto
}
llm-config {
  overflow: auto
}

stat-c {
  margin: var(--space-sm)
}

guide-c {
  width: 100%
  height: 100%
  background: var(--bg-color)
  display: flex
  flex-direction: column
  align-items: center
  justify-content: center
  gap: var(--space-md)
  padding: var(--space-sm)
  white-space: break-spaces
}
details {
  max-width: 40ch
  > * {
    padding: 0.5lh
  }
}
summary {
  cursor: pointer
}

user-config obj-c.visual {
  max-width: 60ch
}

asset-picker {
  display: flex
  flex-direction: column
  align-items: center
  max-width: 100%
  > button {
    min-width: 20ch
    width: fit-content
  }
  > section {
    min-width: 40ch
    padding: var(--space-sm)
    border: 1px solid var(--mild-border-color)
    background: var(--bg-color)
    display: flex
    flex-direction: column
    gap: var(--space-sm)
    border-radius: var(--border-rad)
  }

  > section[hidden] {
    display: none
  }

  .files {
    max-height: 24lh
    overflow-y: auto
    padding-right: 1px
  }

  .file {
    display: flex
    align-items: center
    gap: var(--space-sm)
    > button:first-of-type {
      flex: 1
      text-align: left
      overflow-wrap: anywhere
    }
    img {
      width: 3lh
      height: 3lh
      object-fit: cover
    }
  }
}

controls-c {
  width: 100%
  height: 100%
  display: flex
  flex-direction: column
  align-items: center
  justify-content: center
}

body > dialog {
  // border-radius: var(--border-rad)
  overflow: visible
  min-width: 40ch
  min-height: 20lh
  color: var(--ui-color)
  border: unset
  outline: unset
  padding: unset
  background: unset
  > button.close {
    width: 100%
  }
}
body > dialog:focus {
  border: unset
  outline: unset
  padding: unset
  background: unset
}

logs-c {
  display: flex
  flex-direction: column
  padding: 0.5lh
  gap: 0.5lh
  max-width: 80ch
  width: 80ch
  * {
    white-space: break-spaces
    text-align: left
  }
  pre {
    padding: 0.5lh
    background: var(--bg-color)
  }
  > .content {
    display: flex
    flex-direction: column
    gap: 0.5lh
  }
}

top-bar {
  background: var(--bg-color);
  position: absolute;
  top: 0px;
  width: 100vw;
  min-height: 5px;
  height: 0.5lh;
  overflow: clip;
  opacity: 0%;
  transition: opacity 0.3s ease, height 0.3s ease;
  button {
    border-radius: 0
  }
}

top-bar:hover, top-bar:focus, top-bar:has(*:focus)  {
  height: fit-content
  opacity: 100%
}