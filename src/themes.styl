/* ========================================================================== */
/* Font faces */
/* ========================================================================== */

@font-face {
  font-family: "DM Mono";
  src: local("DM Mono"), url(../fonts/DMMono-Regular.ttf) format("truetype");
}

@font-face {
  font-family: "Poppins";
  src: local("Poppins"), url(../fonts/Poppins-Regular.ttf) format("truetype");
}

@font-face {
  font-family: "Circular";
  src: local("Circular std"), url(../fonts/CircularStd-Book.ttf) format("truetype");
}

@font-face {
  font-family: "Baskervville";
  src: local("Baskervville"), url(../fonts/Baskervville-Regular.ttf) format("truetype");
}

@font-face {
  font-family: "SUIT";
  src: local("SUIT"), url(../fonts/SUIT-Variabe.woff2) format("woff2");
}
@font-face {
  font-family: "DM Sans";
  src: local("DM Sans"), url(../fonts/DMSans-variable.ttf) format("truetype");
}
@font-face {
  font-family: "Urbanist";
  src: local("Urbanist"), url(../fonts/Urbanist-VariableFont_wght.ttf) format("truetype");
}

hsl2(hue, saturation, lightness)
  unquote("hsl(" + "calc(var(--hue-shift) + " + hue + ")," + saturation + "%," + lightness + "%" + ")")


/* ========================================================================== */
/* Shared palette and default theme */
/* ========================================================================== */

:root {
  --light: white;
  --dark: black;
  --light-grad: linear-gradient(to bottom, hsl(0deg 0% 95%), hsl(0deg 0% 90%) 80%, hsl(0deg 0% 85%) 100%);
  --dark-grad: linear-gradient(to top, hsl(0deg 0% 15%), hsl(0deg 0% 30%) 80%, hsl(0deg 0% 35%) 100%);
  caret-color: var(--dark);
}

/* 
-----------
*/

:root {
  
  
  font-family: "DM Sans", "Inconsolata", "SUIT", "SUIT Variable";
  font-weight: 400;

  body {
    background-size: cover;
    background-position: center;
  }
  
  --border-color: hsl2(0, 33, 70);
  --mild-border-color: hsl2(0, 33, 60);
  --active-bg-color: hsl2(0, 33, 10);
  --ui-color: var(--dark); 
  --bg-color: var(--light);
  --button-grad: var(--light-grad);
  --error: rgb(232, 39, 71);
  --accent: hsl2(0, 80, 90);
  
  --alert: var(--accent);
  --quote: var(--accent);
  --value: var(--ui-color);
  --text: var(--value);
  --obj: var(--accent);
  --dir: var(--accent-2);
  --file: var(--accent);

  --hue-shift: 200;
  --saturation-shift: 0;
  --lightness-shift: 0;

  --border-rad: 0;

}


/* ========================================================================== */
/* Dark mode override */
/* ========================================================================== */

:root.dark {
  --ui-color: var(--light);
  --bg-color: var(--dark);
  --button-grad: var(--dark-grad);
  caret-color: var(--light);
}

/* ========================================================================== */
/* Theme variants */
/* ========================================================================== */

/* Cozy theme */
:root.cozy {

  --light: hsl2(0, 20, 72);
  --dark: hsl2(0, 15, 17);
  --border-color: hsl2(0, 15, 52);
  --mild-border-color: hsl2(18, 15, 40);
  --active-bg-color: hsl2(0, 18, 15);
  --accent: hsl2(0, 45, 70)
  
  --hue-shift: 180;
  --border-rad: 0.5lh

  body {
    background-image: url("../assets/bg/4.jpg");
  }
}

:root.steel {
  --hue-shift: 210
}

:root.forest {
  --hue-shift: 150
}


/* Parade theme */
:root.parade {
  /* 
    iMessage type looking, pastel colorful.
  */
  --light: hsl(229, 42%, 87%);
  --dark: rgb(37, 39, 50);
  
  --border-color: hsla(310, 42%, 72%, 0.8);
  --mild-border-color: rgba(144, 125, 196, 0.8);
  --active-bg-color: hsla(136, 58%, 89%, 0.8);
  --accent: rgb(215, 141, 210);
  --accent-2: rgb(219, 138, 228);

  --border-rad: 0.75lh
  
  body {
    background-image: url("../assets/bg/12.jpg");
  }
}

:root.parade.dark {
  /* 
    iMessage type looking, pastel colorful.
  */
  --active-bg-color: hsla(215, 30%, 22%, 0.8);
}

/* Pro theme */
:root.pro {
  font-family: "DM Mono", monospace;
  font-weight: 400;
  letter-spacing: 0.08ch;

  body {
    background-image: url("../assets/bg/3.jpg");
  }

  --hue-shift: 0;
  --saturation-shift: 0;
  --lightness-shift: 0;

  --border-rad: 0.25lh;
  

  --light: hsl2(230,  5, 90);
  --dark: hsl2(230, 12, 20);
  --border-color: hsl2(230, 12, 60);
  --mild-border-color: hsl2(230, 5, 40);
  --active-bg-color: hsl2(250, 15, 15);
  
  --accent: hsl2(40, 75, 75);
  --accent-2: hsl2(60, 70, 50);
  --alert: var(--accent);
  --quote: var(--accent);

  --value: var(--ui-color);
  --text: var(--value);
  
  --obj: var(--accent);

  --dir: var(--accent-2);
  --file: var(--accent);
}

/* Font-focused themes */
:root.artsy {
  font-family: "Baskervville";
  --hue-shift: 33;
  body {
    background-image: url("../assets/bg/15.jpg");
  }
  start-c.pretty {
    position: relative;
    h1 {
      font-family: "soulgate";
    }
  }
}

:root.cool {
  hue-shift: 220;
  body {
    background-image: url("../assets/bg/9.jpg");
  }
}


@css {
  input, button, select, *[contenteditable="true"], group-c, obj-c, list-c > *, guide-c {
    background: color-mix(
      in hsl,
      var(--bg-color),
      rgba(0,0,0,0) 70%
    );
  }
}


/* ========================================================================== */
/* Glassy surface effect */
/* ========================================================================== */

@css {
  :root.glassy {
    main {
      background: color-mix(
        in hsl,
        var(--bg-color),
        rgba(0,0,0,0) 50%
      );
      > stack-c {
        backdrop-filter: blur(4px);
        box-shadow: unset
      }
    }

    request-c {
      box-shadow: unset;
      outline: unset;
    }
    
    input, button, select, *[contenteditable="true"], group-c, obj-c, list-c > *, guide-c {
      background: color-mix(
        in hsl,
        var(--bg-color),
        rgba(0,0,0,0) 80%
      );
      backdrop-filter: blur(4px);
    }

    input:focus, button:focus, select:focus, *[contenteditable="true"]:focus, list-c > .item:hover {
      background: color-mix(
        in hsl,
        var(--active-bg-color),
        rgba(0,0,0,0) 30%
      );
    }
    
    message-c {
      background-color: color-mix(
        in hsl,
        var(--bg-color),
        rgba(0,0,0,0) 40%
      );
      backdrop-filter: blur(8px);
    }
  }
}
